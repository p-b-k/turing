PROJ_NAME="Turing Machine"
PROJ_PATH=$(pwd)
PATH=$PATH:${PROJ_PATH}/target/debug

INIT_ENV=$HOME/.config/pmgr/init.env
RUST_ENV=$HOME/.config/pmgr/rust.env

EDITOR_HEIGHT=734
function edit {
	WCLASS="proj-${PROJ_ID}-helix"
	# echo "WMCLASS = $WM_CLASS"

	if ! pgrep -fi "$WCLASS" > /dev/null; then
		kstart --  kitty --directory=$PROJ_PATH --class=$WCLASS \
		      -o initial_window_height=$EDITOR_HEIGHT \
		      -o background_image=/home/pbk/.local/backgrounds/desert.png \
		      helix
	else
		KWIN_SCRIPT="
		var windows = workspace.windowList();
		for (var i = 0; i < windows.length; i++) {
			if (windows[i].resourceClass == '$WCLASS') {
				workspace.activeWindow = windows[i];
				break;
			}
		}
		"

		# echo "KWIN_SCRIPT = $KWIN_SCRIPT"
		kwin_run $KWIN_SCRIPT
	fi
}
